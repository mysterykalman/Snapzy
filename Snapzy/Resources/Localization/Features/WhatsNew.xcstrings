    "whats-new.copy-as.desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Right-click any capture in History to copy it as a Markdown image or HTML <img> tag."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke mit der rechten Maustaste auf eine Aufnahme im Verlauf, um sie als Markdown-Bild oder HTML-<img>-Tag zu kopieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic derecho en cualquier captura del historial para copiarla como imagen Markdown o etiqueta HTML <img>."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites un clic droit sur une capture dans l'historique pour la copier en tant qu'image Markdown ou balise HTML <img>."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "履歴内のキャプチャを右クリックすると、Markdown画像またはHTMLの<img>タグとしてコピーできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록에서 캡처를 마우스 오른쪽 버튼으로 클릭하여 Markdown 이미지 또는 HTML <img> 태그로 복사하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Щёлкните правой кнопкой мыши на любом снимке в истории, чтобы скопировать его как изображение Markdown или тег HTML <img>."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhấp chuột phải vào bất kỳ ảnh chụp nào trong Lịch sử để sao chép dưới dạng ảnh Markdown hoặc thẻ HTML <img>."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在历史记录中右键点击任意截图，即可复制为 Markdown 图片或 HTML <img> 标签。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在歷史記錄中右鍵點擊任意截圖，即可複製為 Markdown 圖片或 HTML <img> 標籤。"
          }
        }
      }
    }
