          }
        }
      }
    },
    "whats-new.annotation-tools.desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stamp, Measurement, Group/Ungroup, explicit layer ordering, and richer Counter formats are here."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stempel, Messung, Gruppieren/Gruppierung aufheben, explizite Ebenenreihenfolge und erweiterte Zähler-Formate sind da."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sello, Medición, Agrupar/Desagrupar, orden explícito de capas y formatos de contador más completos ya están aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tampon, Mesure, Grouper/Dissocier, ordre explicite des calques et formats de compteur enrichis sont arrivés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スタンプ、測定、グループ化/解除、明示的なレイヤー順序、より豊富なカウンター形式が登場しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스탬프, 측정, 그룹화/해제, 명시적 레이어 순서, 더 다양한 카운터 형식이 추가되었습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Штамп, измерение, группировка/разгруппировка, явный порядок слоёв и более широкие форматы счётчика уже здесь."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Con dấu, Đo lường, Nhóm/Bỏ nhóm, thứ tự lớp rõ ràng và định dạng Bộ đếm phong phú hơn đã có mặt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图章、测量、编组/取消编组、显式图层顺序，以及更丰富的计数器格式都来了。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "圖章、測量、編組/取消編組、明確的圖層順序，以及更豐富的計數器格式都來了。"
          }
        }
      }
    },
