    "whats-new.group-zorder.desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select multiple annotations and press ⌘G to group them, or ⌘] / ⌘[ to move one forward or back in the stack."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle mehrere Anmerkungen aus und drücke ⌘G, um sie zu gruppieren, oder ⌘] / ⌘[, um eine im Stapel nach vorne oder hinten zu verschieben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona varias anotaciones y pulsa ⌘G para agruparlas, o ⌘] / ⌘[ para mover una hacia adelante o atrás en la pila."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionnez plusieurs annotations et appuyez sur ⌘G pour les grouper, ou ⌘] / ⌘[ pour en déplacer une vers l'avant ou l'arrière dans la pile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "複数の注釈を選択して⌘Gを押すとグループ化、⌘]/⌘[で重なり順を前後に移動できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여러 주석을 선택하고 ⌘G를 눌러 그룹화하거나, ⌘] / ⌘[로 스택에서 앞뒤로 이동하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите несколько аннотаций и нажмите ⌘G, чтобы сгруппировать их, или ⌘] / ⌘[, чтобы переместить одну вперёд или назад в стеке."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn nhiều chú thích và nhấn ⌘G để nhóm chúng lại, hoặc ⌘] / ⌘[ để di chuyển một mục lên trước hoặc ra sau trong chồng lớp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择多个注释并按 ⌘G 编组，或按 ⌘] / ⌘[ 将某一项在堆叠中前移或后移。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選取多個註釋並按 ⌘G 編組，或按 ⌘] / ⌘[ 將某一項在堆疊中前移或後移。"
          }
        }
      }
    },
