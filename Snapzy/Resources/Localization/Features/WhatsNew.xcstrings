    "whats-new.measurement.desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A ruler tool with end ticks and a distance label -- drag between two points to measure."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Lineal-Werkzeug mit Endmarkierungen und Entfernungsangabe -- ziehe zwischen zwei Punkten, um zu messen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una herramienta de regla con marcas en los extremos y una etiqueta de distancia: arrastra entre dos puntos para medir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un outil règle avec des repères aux extrémités et une étiquette de distance -- faites glisser entre deux points pour mesurer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "端に目盛りと距離ラベルが付いた定規ツール -- 2点間をドラッグして測定します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "끝에 눈금과 거리 라벨이 있는 자 도구입니다 -- 두 지점 사이를 드래그하여 측정하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Инструмент линейки с засечками на концах и меткой расстояния -- перетащите между двумя точками, чтобы измерить."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Công cụ thước kẻ có vạch đầu mút và nhãn khoảng cách -- kéo giữa hai điểm để đo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "带端点刻度和距离标签的直尺工具——在两点之间拖动即可测量。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "帶端點刻度和距離標籤的直尺工具——在兩點之間拖曳即可測量。"
          }
        }
      }
    },
