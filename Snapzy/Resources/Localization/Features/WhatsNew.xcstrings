    "whats-new.counter-formats.desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Number your callouts as 1, 2, 3, letters, or Roman numerals, and choose where the count starts."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nummeriere deine Callouts als 1, 2, 3, Buchstaben oder römische Ziffern und lege fest, wo die Zählung beginnt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Numera tus llamadas como 1, 2, 3, letras o números romanos, y elige dónde empieza el conteo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Numérotez vos rappels en 1, 2, 3, lettres ou chiffres romains, et choisissez où le comptage commence."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コールアウトを1、2、3、文字、ローマ数字のいずれかで番号付けし、開始番号も選べます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "콜아웃 번호를 1, 2, 3, 문자 또는 로마 숫자로 매기고 시작 값을 선택하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нумеруйте выноски как 1, 2, 3, буквами или римскими цифрами и выбирайте, с чего начинать отсчёт."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đánh số chú thích của bạn bằng 1, 2, 3, chữ cái hoặc số La Mã, và chọn nơi bắt đầu đếm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将标注编号为 1、2、3、字母或罗马数字，并可选择起始编号。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將標註編號為 1、2、3、字母或羅馬數字，並可選擇起始編號。"
          }
        }
      }
    },
