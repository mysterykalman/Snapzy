    "whats-new.stamp.desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drop a check, cross, warning, bug, or CRO marker directly onto a screenshot to flag it at a glance."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setze ein Häkchen, Kreuz, eine Warnung, einen Fehler oder eine CRO-Markierung direkt auf einen Screenshot, um ihn auf einen Blick zu kennzeichnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloca una marca, cruz, advertencia, error o marcador CRO directamente en una captura para señalarla de un vistazo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Placez une coche, une croix, un avertissement, un bug ou un repère CRO directement sur une capture pour la signaler d'un coup d'œil."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チェック、バツ、警告、バグ、CROマーカーをスクリーンショットに直接配置して一目でフラグを立てられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "체크, 엑스, 경고, 버그, CRO 마커를 스크린샷에 바로 찍어 한눈에 표시할 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разместите отметку, крестик, предупреждение, ошибку или маркер CRO прямо на скриншоте, чтобы отметить его с первого взгляда."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đặt dấu tích, dấu chéo, cảnh báo, lỗi hoặc dấu CRO trực tiếp lên ảnh chụp màn hình để đánh dấu ngay lập tức."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "直接在截图上放置对勾、叉号、警告、错误或 CRO 标记，一目了然。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "直接在截圖上放置打勾、叉號、警告、錯誤或 CRO 標記，一目瞭然。"
          }
        }
      }
    },
