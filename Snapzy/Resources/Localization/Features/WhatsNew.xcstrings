          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нотариальное заверение Apple"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 公证认证"
          }
        },
        "zh-Hant": {
